# Copy to .env and fill in. This is the only place config values live.
# compose passes this whole file into each container as environment variables (env_file).

# Read by the postgres image on first start to create the user and database.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Read by the app (settings.py). Host is the compose service name "postgres".
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/DB

# Laptop only: host-side pytest reaches the same DB via the port in compose.override.yml.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB

# Vault structure rules (D-006), read by the parser. JSON for maps and lists.
# Index settings (PARSE group, D-010): changing any of these makes the next sync a full index
# that rewrites affected rows; nothing is re-embedded unless a note's cleaned text changes.
# Top-level folder -> note_type; values must be one of the notes.note_type CHECK values.
VAULT_FOLDER_TYPES='{"00 Meta": "meta", "01 MOCs": "moc", "02 Concepts": "concept", "03 Sources": "source", "04 Fleeting": "fleeting"}'
# note_type for notes at the vault root or in a folder not listed above.
VAULT_DEFAULT_NOTE_TYPE=fleeting
# Top-level folders never indexed (hidden folders like .obsidian/.git are always skipped).
VAULT_EXCLUDED_DIRS='["Templates", "Bases", "Attachments"]'
# Fenced code blocks removed entirely (plugin queries, not content).
VAULT_STRIPPED_FENCES='["dataview", "dataviewjs", "base"]'

# Chunker (sizes in characters; sprint-2/task_1 profile). ~4 chars per token; bge-small max is 512 tokens.
# Index settings (EMBED group, D-010), like CHUNK_METADATA_HEADINGS and EMBEDDING_MODEL/_FILE/_POOLING
# below: changing any of them makes the next sync a full index that re-embeds every note.
CHUNK_MAX_CHARS=1500
# Neighbouring sections merge when either is smaller than this (and the result fits CHUNK_MAX_CHARS).
CHUNK_MERGE_BELOW_CHARS=200
# When an oversize section is split, its last paragraph is repeated in the next window if this short.
CHUNK_OVERLAP_CHARS=300
# Notes whose cleaned body is shorter than this are not indexed at all (SPEC §14).
STUB_MIN_CHARS=100

# Embeddings (ADR-0003). EMBEDDING_DIM must match the chunks.embedding column (vector(384)).
# MODEL, MODEL_FILE, POOLING are EMBED-group index settings (full re-embed on change). BATCH_SIZE,
# CACHE_DIR and QUERY_PREFIX are runtime knobs: changing them never triggers a re-index.
# Hugging Face repo + ONNX file. int8 (34 MB) runs on x86 and arm64 alike; ~same vectors as fp32.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_MODEL_FILE=onnx/model_quantized.onnx
# bge uses the [CLS] token as the sentence vector (cls); mean-pooled models use mean.
EMBEDDING_POOLING=cls
EMBEDDING_DIM=384
# 1 = no padding to the longest chunk in a batch: ~5x faster, ~6x less RAM than 64 (task_5 bench).
EMBEDDING_BATCH_SIZE=1
# Model download cache, relative to the working dir: ./models on the laptop, the models volume in compose.
EMBEDDING_CACHE_DIR=models
# bge's query instruction; fastembed doesn't add it. Set to empty to ablate (Sprint 4).
EMBEDDING_QUERY_PREFIX='Represent this sentence for searching relevant passages: '

# Vault clone the indexer reads (a git repo; only committed files are indexed).
# Path inside the app container; compose.override.yml mounts VAULT_HOST_PATH there read-only.
VAULT_PATH=/vault
# Laptop only: host path of the vault clone, mounted read-only at VAULT_PATH by compose.override.yml.
VAULT_HOST_PATH=/path/to/vault-clone

# Headings that are structure, not topic: they start a section but never appear in heading_path.
CHUNK_METADATA_HEADINGS='["Part of"]'

# GitHub webhook. The secret must match the one set on the vault repo's webhook (Sprint 1 Task 6).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
# How many recent X-GitHub-Delivery ids to remember for dedupe (in memory; reset on restart).
WEBHOOK_SEEN_DELIVERIES=1000

# Which commit the indexer follows. Laptop: HEAD of the mounted (read-only) clone, no fetch.
# VM: VAULT_FETCH=true and VAULT_REF=origin/main (the system's own writable clone).
# VAULT_FETCH=true also means "this clone belongs to the system": after every successful sync its
# files are reset (git reset --hard) to the indexed commit (D-010). Keep it false for any clone
# you edit by hand — e.g. the laptop's Obsidian vault.
VAULT_REF=HEAD
VAULT_FETCH=false

# Graph (Sprint 3, ADR-0010). Read at query time: changing these never re-indexes.
# A tag on more than this share of notes is too generic to connect notes as a hub (sprint-2/task_1:
# the biggest tag covers 5.6%, so today nothing is excluded; this guards against a future #todo).
GRAPH_TAG_HUB_MAX_SHARE=0.10
# Expansion from the retrieval seeds (SPEC §9 step 4, D-007). Depth: 2 per SPEC; 1 = direct
# neighbours only (Sprint 4 ablation).
GRAPH_MAX_HOPS=2
# Per note per hop: at most this many neighbours, best first (links/parent/child, then siblings,
# then tag-mates). Keeps a MOC (up to 42 members) or a tag (up to 41 mates) from flooding a hop.
GRAPH_FANOUT_CAP=10
# Notes returned in total across all hops, seeds not included. MOCs don't count: they are
# passed through and never become context (ADR-0010).
GRAPH_TOTAL_CAP=30

# Retrieval (Sprint 4, SPEC §9). Read at query time: changing these never re-indexes.
# Chunks each retriever (lexical, vector) hands to fusion; the seeds are the top few after it.
RETRIEVAL_CANDIDATES=50
# Min cosine similarity of the best vector match to proceed past early refusal. If the
# closest chunk is below this, the vault doesn't cover the question — fusion returns no seeds.
# Not yet tuned: placeholder pending the owner's eval rewrite (D-003).
RETRIEVAL_RELEVANCE_FLOOR=0.3
