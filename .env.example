# Copy to .env and fill in. This is the only place config values live.
# compose passes this whole file into each container as environment variables (env_file).

# Read by the postgres image on first start to create the user and database.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Read by the app (settings.py). Host is the compose service name "postgres".
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/DB

# Laptop only: host-side pytest reaches the same DB via the port in compose.override.yml.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB

# Vault structure rules (D-006), read by the parser. JSON for maps and lists.
# Top-level folder -> note_type; values must be one of the notes.note_type CHECK values.
VAULT_FOLDER_TYPES='{"00 Meta": "meta", "01 MOCs": "moc", "02 Concepts": "concept", "03 Sources": "source", "04 Fleeting": "fleeting"}'
# note_type for notes at the vault root or in a folder not listed above.
VAULT_DEFAULT_NOTE_TYPE=fleeting
# Top-level folders never indexed (hidden folders like .obsidian/.git are always skipped).
VAULT_EXCLUDED_DIRS='["Templates", "Bases", "Attachments"]'
# Fenced code blocks removed entirely (plugin queries, not content).
VAULT_STRIPPED_FENCES='["dataview", "dataviewjs", "base"]'

# Chunker (sizes in characters; sprint-2/task_1 profile). ~4 chars per token; bge-small max is 512 tokens.
CHUNK_MAX_CHARS=1500
# Neighbouring sections merge when either is smaller than this (and the result fits CHUNK_MAX_CHARS).
CHUNK_MERGE_BELOW_CHARS=200
# When an oversize section is split, its last paragraph is repeated in the next window if this short.
CHUNK_OVERLAP_CHARS=300
# Notes whose cleaned body is shorter than this are not indexed at all (SPEC §14).
STUB_MIN_CHARS=100

# Embeddings (ADR-0003). EMBEDDING_DIM must match the chunks.embedding column (vector(384)).
# Hugging Face repo + ONNX file. int8 (34 MB) runs on x86 and arm64 alike; ~same vectors as fp32.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_MODEL_FILE=onnx/model_quantized.onnx
# bge uses the [CLS] token as the sentence vector (cls); mean-pooled models use mean.
EMBEDDING_POOLING=cls
EMBEDDING_DIM=384
# 1 = no padding to the longest chunk in a batch: ~5x faster, ~6x less RAM than 64 (task_5 bench).
EMBEDDING_BATCH_SIZE=1
# Model download cache, relative to the working dir: ./models on the laptop, the models volume in compose.
EMBEDDING_CACHE_DIR=models
# bge's query instruction; fastembed doesn't add it. Set to empty to ablate (Sprint 4).
EMBEDDING_QUERY_PREFIX='Represent this sentence for searching relevant passages: '
