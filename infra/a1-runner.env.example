# Copy to /etc/a1-runner.env on the Micro (sudo install -m 600 ...). No defaults in code.
TOPIC_OCID=
INSTANCE_NAME=ask-ragu
# Micro boot volume + this must stay within the 200 GB free allowance (quota enforces it).
BOOT_VOLUME_GB=100
# Local hours (IST) when a 1/6 → 2/12 resize may be tried; a resize reboots the A1.
RESIZE_HOURS=1-6
